<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FocusKey.Overlay.QuickOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Focus Key — Quick Overlay">

    <Border
        x:Name="Surface"
        Width="560"
        Padding="24,18,24,18"
        Background="{ThemeResource FkOverlay}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel
            x:Name="RootPanel"
            Spacing="0"
            TabFocusNavigation="Cycle">

            <!-- Persistent Draggable Header (Present in all modes) -->
            <Grid
                x:Name="HeaderGrid"
                Margin="0,0,0,12"
                Height="28"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Idle title or Active session badge -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Ellipse
                        x:Name="ActiveBadgeDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="HeaderTitle"
                        Text="FOCUS KEY"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource FkSecondary}"
                        CharacterSpacing="60"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Middle: Draggable surface -->
                <Border
                    x:Name="HeaderDragArea"
                    Grid.Column="1"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerPressed="OnHeaderPointerPressed" />

                <!-- Right: Shortcut hint and Close button -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="ShortcutHintContainer"
                        Background="{ThemeResource FkSurface2}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="OverlayShortcutHint"
                            Text="Shift + F3"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}" />
                    </Border>
                    <Button
                        x:Name="CloseButton"
                        Content="&#xE8BB;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="10"
                        Width="24"
                        Height="24"
                        Padding="0"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Close Overlay"
                        Click="OnCloseButtonClick" />
                </StackPanel>
            </Grid>

            <!-- 1. Idle Content (Selection Cards + Start Button) -->
            <StackPanel x:Name="IdleContent" Spacing="0">
                <!-- Top subheader -->
                <TextBlock
                    Text="Start a session"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="{ThemeResource FkSecondary}"
                    Margin="0,0,0,12" />

                <!-- Selection Cards (Idle mode) -->
                <Grid x:Name="SelectionCards" Margin="0,0,0,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="WorkCard"
                        Grid.Column="0"
                        Style="{StaticResource FkOverlayCard}"
                        HorizontalContentAlignment="Stretch"
                        UseSystemFocusVisuals="True"
                        FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                        FocusVisualSecondaryBrush="Transparent"
                        FocusVisualPrimaryThickness="1"
                        TabIndex="0"
                        Height="48"
                        Padding="14,0"
                        AutomationProperties.Name="Work"
                        Click="OnWorkClicked">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="WorkDot" Width="6" Height="6" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="WorkLabel" Text="WORK"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="60"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                x:Name="WorkDuration"
                                Text="--:--"
                                FontFamily="Consolas"
                                FontSize="18"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="BreakCard"
                        Grid.Column="1"
                        Style="{StaticResource FkOverlayCard}"
                        HorizontalContentAlignment="Stretch"
                        UseSystemFocusVisuals="True"
                        FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                        FocusVisualSecondaryBrush="Transparent"
                        FocusVisualPrimaryThickness="1"
                        TabIndex="1"
                        Height="48"
                        Padding="14,0"
                        AutomationProperties.Name="Break"
                        Click="OnBreakClicked">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="BreakDot" Width="6" Height="6" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="BreakLabel" Text="BREAK"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="60"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                x:Name="BreakDuration"
                                Text="--:--"
                                FontFamily="Consolas"
                                FontSize="18"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Start Button (Idle mode) -->
                <Button
                    x:Name="StartButton"
                    Style="{StaticResource FkOverlayStartButton}"
                    Content="Start"
                    UseSystemFocusVisuals="True"
                    FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                    FocusVisualSecondaryBrush="Transparent"
                    FocusVisualPrimaryThickness="1"
                    TabIndex="2"
                    Height="36"
                    MinWidth="140"
                    Padding="24,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Start"
                    Click="OnStartClicked" />

                <!-- Keyboard shortcuts (Idle mode) -->
                <StackPanel
                    x:Name="KeyboardHints"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Border
                            Background="{ThemeResource FkSurface2}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1">
                            <TextBlock
                                Text="←→"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource FkSecondary}" />
                        </Border>
                        <TextBlock
                            Text="Select"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}"
                            VerticalAlignment="Center"
                            Margin="5,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Border
                            Background="{ThemeResource FkSurface2}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1">
                            <TextBlock
                                Text="↵"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource FkSecondary}" />
                        </Border>
                        <TextBlock
                            x:Name="StartKeyHint"
                            Text="Start"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}"
                            VerticalAlignment="Center"
                            Margin="5,0,0,0" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Background="Transparent"
                        PointerPressed="OnCloseClicked">
                        <Border
                            Background="{ThemeResource FkSurface2}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1">
                            <TextBlock
                                Text="Esc"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource FkSecondary}" />
                        </Border>
                        <TextBlock
                            Text="Close"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}"
                            VerticalAlignment="Center"
                            Margin="5,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 2. Active Content (Running & Paused modes) -->
            <StackPanel x:Name="ActiveCard" Visibility="Collapsed" Spacing="0">
                <!-- Active Subheader (WORK SESSION ... RUNNING/PAUSED) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="ActiveSubDot" Width="6" Height="6" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ActiveSubHeading"
                            Text="WORK SESSION"
                            FontSize="11"
                            FontWeight="SemiBold"
                            CharacterSpacing="60"
                            Foreground="{ThemeResource FkSecondary}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        x:Name="ActiveSubBadge"
                        Text="RUNNING"
                        FontSize="11"
                        FontWeight="SemiBold"
                        CharacterSpacing="60"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Large Countdown Display (52 DIP font size) -->
                <StackPanel HorizontalAlignment="Center" Spacing="2" Margin="0,4,0,8">
                    <TextBlock
                        x:Name="ActiveRemaining"
                        FontSize="52"
                        FontFamily="Consolas"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="{ThemeResource FkForeground}"
                        CharacterSpacing="-20"
                        Language="en-US"
                        FlowDirection="LeftToRight"
                        TextReadingOrder="UseFlowDirection" />
                    <TextBlock
                        x:Name="ActiveHint"
                        Text="remaining"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="{ThemeResource FkSecondary}" />
                </StackPanel>

                <!-- Progress bar line (6 DIP height) -->
                <Border
                    x:Name="ProgressTrack"
                    Height="6"
                    CornerRadius="3"
                    Background="{ThemeResource FkBorder}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,16">
                    <Border
                        x:Name="ProgressBar"
                        Height="6"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        Width="0" />
                </Border>

                <!-- Action buttons (centered) -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button
                        x:Name="ContinueButton"
                        Content="Continue"
                        Style="{StaticResource FkOverlayStopButton}"
                        UseSystemFocusVisuals="True"
                        FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                        FocusVisualSecondaryBrush="Transparent"
                        FocusVisualPrimaryThickness="1"
                        MinWidth="120"
                        Height="36"
                        Padding="22,0"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Continue Session"
                        Click="OnContinueClicked" />
                    <Button
                        x:Name="StartNewButton"
                        Content="Start New"
                        Style="{StaticResource FkOverlayStopButton}"
                        UseSystemFocusVisuals="True"
                        FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                        FocusVisualSecondaryBrush="Transparent"
                        FocusVisualPrimaryThickness="1"
                        MinWidth="110"
                        Height="36"
                        Padding="20,0"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Start New Session"
                        Click="OnStartNewClicked" />
                    <Button
                        x:Name="PauseButton"
                        Content="Pause"
                        Style="{StaticResource FkOverlayStopButton}"
                        UseSystemFocusVisuals="True"
                        FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                        FocusVisualSecondaryBrush="Transparent"
                        FocusVisualPrimaryThickness="1"
                        MinWidth="110"
                        Height="36"
                        Padding="22,0"
                        AutomationProperties.Name="Pause Session"
                        Click="OnPauseClicked" />
                    <!-- Hidden StopButton kept for event hookup safety -->
                    <Button
                        x:Name="StopButton"
                        Content="Stop"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Stop Session"
                        Click="OnStopClicked" />
                </StackPanel>

                <!-- Keyboard shortcuts (Active mode) -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
                    <StackPanel x:Name="ActiveKeyHintContainer" Orientation="Horizontal" Margin="0,0,16,0">
                        <Border
                            Background="{ThemeResource FkSurface2}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1">
                            <TextBlock
                                x:Name="ActiveKeyGlyph"
                                Text="↵"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource FkSecondary}" />
                        </Border>
                        <TextBlock
                            x:Name="ActiveKeyActionText"
                            Text="Pause"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}"
                            VerticalAlignment="Center"
                            Margin="5,0,0,0" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Background="Transparent"
                        PointerPressed="OnCloseClicked">
                        <Border
                            Background="{ThemeResource FkSurface2}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1">
                            <TextBlock
                                Text="Esc"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource FkSecondary}" />
                        </Border>
                        <TextBlock
                            Text="Close"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}"
                            VerticalAlignment="Center"
                            Margin="5,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Feedback / Error text -->
            <TextBlock
                x:Name="FeedbackText"
                Text=""
                Visibility="Collapsed"
                Foreground="{ThemeResource FkSecondary}"
                FontSize="12"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" />

        </StackPanel>
    </Border>
</Window>

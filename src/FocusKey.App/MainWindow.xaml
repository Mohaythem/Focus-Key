<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FocusKey.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus Key">
    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Focus Key" FontSize="22" FontWeight="SemiBold"/>
            <ToggleButton x:Name="TodayNav" Content="Today" HorizontalAlignment="Stretch" Click="OnTodayClick"/>
            <ToggleButton x:Name="ReportsNav" Content="Reports" HorizontalAlignment="Stretch" Click="OnReportsClick"/>
            <ToggleButton x:Name="SettingsNav" Content="Settings" HorizontalAlignment="Stretch" Click="OnSettingsClick"/>
            <TextBlock Text="Shift + F3 to start a session" TextWrapping="Wrap" Opacity="0.7"/>
            <Button Content="Exit Focus Key" Click="OnExitClick"/>
        </StackPanel>
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="16">
                <TextBlock x:Name="PageTitle" Text="Today" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="Placeholder" Visibility="Collapsed" TextWrapping="Wrap"/>
                <ContentControl x:Name="ReportsHost" Visibility="Collapsed"/>
                <StackPanel x:Name="TodayPanel" Spacing="16">
                    <TextBlock x:Name="DayLabel" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick"/>
                        <TextBlock x:Name="LoadStatus" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Current session" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RunningText" Text="No running session." TextWrapping="Wrap"/>
                    <ProgressBar x:Name="SessionProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <Button x:Name="StopButton" Content="Stop session" Click="OnStopClick" Visibility="Collapsed"/>
                    <TextBlock Text="Today summary" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText" Text="No data loaded." TextWrapping="Wrap"/>
                    <TextBlock Text="Activity" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EmptyActivity" Text="No sessions started today."/>
                    <ItemsControl x:Name="ActivityRows"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

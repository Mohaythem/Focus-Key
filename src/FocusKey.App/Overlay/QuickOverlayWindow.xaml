<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FocusKey.Overlay.QuickOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Focus Key — Quick Overlay">

    <Border
        x:Name="Surface"
        Width="420"
        Padding="24"
        Background="{ThemeResource FkOverlay}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel
            x:Name="RootPanel"
            Spacing="0"
            TabFocusNavigation="Cycle">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="FOCUS KEY"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource FkSecondary}"
                    CharacterSpacing="60"
                    VerticalAlignment="Center" />
                <Border
                    Grid.Column="1"
                    Padding="6,2"
                    CornerRadius="3"
                    Background="{ThemeResource FkSurface2}"
                    BorderBrush="{ThemeResource FkBorder}"
                    BorderThickness="1">
                    <TextBlock
                        Text="Shift + F3"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{ThemeResource FkDim}" />
                </Border>
            </Grid>

            <Grid x:Name="SelectionCards" Margin="0,0,0,16" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="WorkCard"
                    Grid.Column="0"
                    Style="{StaticResource FkOverlayCard}"
                    UseSystemFocusVisuals="True"
                    TabIndex="0"
                    AutomationProperties.Name="Work"
                    Click="OnWorkClicked">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="WorkDot" Width="6" Height="6" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="WorkLabel" Text="Work"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{ThemeResource FkForeground}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="WorkDuration"
                            Text="--:--"
                            FontFamily="Consolas"
                            FontSize="22"
                            FontWeight="Normal"
                            Foreground="{ThemeResource FkForeground}" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="BreakCard"
                    Grid.Column="1"
                    Style="{StaticResource FkOverlayCard}"
                    UseSystemFocusVisuals="True"
                    TabIndex="1"
                    AutomationProperties.Name="Break"
                    Click="OnBreakClicked">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="BreakDot" Width="6" Height="6" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="BreakLabel" Text="Break"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{ThemeResource FkForeground}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="BreakDuration"
                            Text="--:--"
                            FontFamily="Consolas"
                            FontSize="22"
                            FontWeight="Normal"
                            Foreground="{ThemeResource FkForeground}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Active Countdown Card: refined Fluent presentation -->
            <Border
                x:Name="ActiveCard"
                Visibility="Collapsed"
                Padding="20,18"
                Margin="0,0,0,16"
                CornerRadius="6"
                Background="{ThemeResource FkSurface2}"
                BorderBrush="{ThemeResource FkBorder}"
                BorderThickness="1">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Ellipse x:Name="ActiveBadgeDot" Width="6" Height="6" VerticalAlignment="Center"/>
                        <TextBlock
                            x:Name="ActiveType"
                            FontSize="11"
                            FontWeight="SemiBold"
                            CharacterSpacing="60"
                            Foreground="{ThemeResource FkSecondary}"/>
                    </StackPanel>
                    <TextBlock
                        x:Name="ActiveRemaining"
                        FontSize="46"
                        FontFamily="Consolas"
                        FontWeight="Normal"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource FkForeground}"
                        Language="en-US"
                        FlowDirection="LeftToRight"
                        TextReadingOrder="UseFlowDirection"/>
                    <TextBlock
                        x:Name="RemainingLabel"
                        Text="remaining"
                        FontSize="11"
                        Foreground="{ThemeResource FkDim}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Stop Button: WinUI native button with explicit height and centering -->
            <Button
                x:Name="StopButton"
                Content="Stop"
                Visibility="Collapsed"
                Style="{StaticResource FkOverlayStopButton}"
                UseSystemFocusVisuals="True"
                Click="OnStopClicked"/>

            <!-- Start Button: WinUI native button with explicit height and centering -->
            <Button
                x:Name="StartButton"
                Content="Start"
                Height="36"
                Padding="16,0"
                CornerRadius="4"
                FontSize="13"
                FontWeight="Medium"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                UseSystemFocusVisuals="True"
                TabIndex="2"
                AutomationProperties.Name="Start"
                Click="OnStartClicked" />

            <TextBlock
                x:Name="FeedbackText"
                Text=""
                Visibility="Collapsed"
                Foreground="{ThemeResource FkSecondary}"
                FontSize="12"
                TextWrapping="Wrap"
                Margin="0,10,0,0"
                AutomationProperties.LiveSetting="Polite" />

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,16,0,0">
                <StackPanel x:Name="SelectionHint" Orientation="Horizontal" Margin="0,0,16,0">
                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1">
                        <TextBlock
                            Text="←→"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}" />
                    </Border>
                    <TextBlock
                        Text="Select"
                        FontSize="10"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1">
                        <TextBlock
                            Text="↵"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}" />
                    </Border>
                    <TextBlock
                        x:Name="ActionHint" Text="Start"
                        FontSize="10"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1">
                        <TextBlock
                            Text="Esc"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}" />
                    </Border>
                    <TextBlock
                        Text="Close"
                        FontSize="10"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>



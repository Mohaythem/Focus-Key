<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FocusKey.Overlay.QuickOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Focus Key — Quick Overlay">

    <Border
        x:Name="Surface"
        Width="420"
        Padding="24"
        Background="{ThemeResource FkOverlay}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel
            x:Name="RootPanel"
            Spacing="0"
            TabFocusNavigation="Cycle">
            <!-- Idle Header (Hidden when Active) -->
            <Grid x:Name="IdleHeader" Margin="0,0,0,20">
                <TextBlock
                    Text="FOCUS KEY"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource FkSecondary}"
                    CharacterSpacing="60"
                    VerticalAlignment="Center" />
                <Border
                    HorizontalAlignment="Right"
                    Background="{ThemeResource FkSurface2}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6,2">
                    <TextBlock
                        x:Name="OverlayShortcutHint"
                        Text="Shift + F3"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{ThemeResource FkSecondary}" />
                </Border>
            </Grid>

            <!-- Selection Cards (Idle mode) -->
            <Grid x:Name="SelectionCards" Margin="0,0,0,16" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="WorkCard"
                    Grid.Column="0"
                    Style="{StaticResource FkOverlayCard}"
                    UseSystemFocusVisuals="True"
                    FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                    FocusVisualSecondaryBrush="Transparent"
                    FocusVisualPrimaryThickness="1"
                    TabIndex="0"
                    AutomationProperties.Name="Work"
                    Click="OnWorkClicked">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="WorkDot" Width="6" Height="6" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="WorkLabel" Text="Work"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                        <TextBlock
                            x:Name="WorkDuration"
                            Text="--:--"
                            FontFamily="Consolas"
                            FontSize="24"
                            CharacterSpacing="-20"
                            FontWeight="Normal" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="BreakCard"
                    Grid.Column="1"
                    Style="{StaticResource FkOverlayCard}"
                    UseSystemFocusVisuals="True"
                    FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                    FocusVisualSecondaryBrush="Transparent"
                    FocusVisualPrimaryThickness="1"
                    TabIndex="1"
                    AutomationProperties.Name="Break"
                    Click="OnBreakClicked">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="BreakDot" Width="6" Height="6" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="BreakLabel" Text="Break"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                        <TextBlock
                            x:Name="BreakDuration"
                            Text="--:--"
                            FontFamily="Consolas"
                            FontSize="24"
                            CharacterSpacing="-20"
                            FontWeight="Normal" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Start Button (Idle mode) -->
            <Button
                x:Name="StartButton"
                Style="{StaticResource FkOverlayStartButton}"
                Content="Start"
                UseSystemFocusVisuals="True"
                FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                FocusVisualSecondaryBrush="Transparent"
                FocusVisualPrimaryThickness="1"
                TabIndex="2"
                AutomationProperties.Name="Start"
                Click="OnStartClicked" />

            <!-- Active Countdown View: matches reference media_1789022630088.png -->
            <StackPanel x:Name="ActiveCard" Visibility="Collapsed" Spacing="0">
                <TextBlock
                    x:Name="ActiveType"
                    Text="WORK SESSION"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="60"
                    Foreground="{ThemeResource FkSecondary}"
                    Margin="0,0,0,18" />
                <TextBlock
                    x:Name="ActiveRemaining"
                    FontSize="36"
                    FontFamily="Consolas"
                    FontWeight="Normal"
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource FkForeground}"
                    Margin="0,0,0,20"
                    Language="en-US"
                    FlowDirection="LeftToRight"
                    TextReadingOrder="UseFlowDirection" />
                <!-- Progress bar line -->
                <Border
                    x:Name="ProgressTrack"
                    Height="3"
                    CornerRadius="2"
                    Background="{ThemeResource FkBorder}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,20">
                    <Border
                        x:Name="ProgressBar"
                        Height="3"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Width="0" />
                </Border>
                <!-- Stop Session button (aligned bottom-right) -->
                <Grid HorizontalAlignment="Right">
                    <Button
                        x:Name="StopButton"
                        Content="Stop Session"
                        Style="{StaticResource FkOverlayStopButton}"
                        UseSystemFocusVisuals="True"
                        FocusVisualPrimaryBrush="{ThemeResource FkSecondary}"
                        FocusVisualSecondaryBrush="Transparent"
                        FocusVisualPrimaryThickness="1"
                        Click="OnStopClicked" />
                </Grid>
            </StackPanel>

            <TextBlock
                x:Name="FeedbackText"
                Text=""
                Visibility="Collapsed"
                Foreground="{ThemeResource FkSecondary}"
                FontSize="12"
                TextWrapping="Wrap"
                Margin="0,10,0,0"
                AutomationProperties.LiveSetting="Polite" />

            <!-- Keyboard shortcuts (Idle mode) -->
            <StackPanel
                x:Name="KeyboardHints"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Border
                        Background="{ThemeResource FkSurface2}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1">
                        <TextBlock
                            Text="←→"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}" />
                    </Border>
                    <TextBlock
                        Text="Select"
                        FontSize="10"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Border
                        Background="{ThemeResource FkSurface2}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1">
                        <TextBlock
                            Text="↵"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}" />
                    </Border>
                    <TextBlock
                        Text="Start"
                        FontSize="10"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Background="Transparent"
                    PointerPressed="OnCloseClicked">
                    <Border
                        Background="{ThemeResource FkSurface2}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1">
                        <TextBlock
                            Text="Esc"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource FkSecondary}" />
                    </Border>
                    <TextBlock
                        Text="Close"
                        FontSize="10"
                        Foreground="{ThemeResource FkSecondary}"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>



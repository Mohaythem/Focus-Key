<Application x:Class="FocusKey.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Dark">
    <SolidColorBrush x:Key="FkBackground" Color="#121212"/><SolidColorBrush x:Key="FkSidebar" Color="#181818"/>
    <SolidColorBrush x:Key="FkSurface" Color="#1E1E1E"/><SolidColorBrush x:Key="FkSurface2" Color="#252525"/>
    <SolidColorBrush x:Key="FkOverlay" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="FkBorder" Color="#2E2E2E"/><SolidColorBrush x:Key="FkForeground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="FkSecondary" Color="#A0A0A0"/><SolidColorBrush x:Key="FkDim" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="FkAccent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="FkStatusRunning" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="FkStatusCompleted" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="FkStatusStopped" Color="#C37878"/>
    <SolidColorBrush x:Key="FkStatusInterrupted" Color="#CD964B"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="Light">
    <SolidColorBrush x:Key="FkBackground" Color="#F2F5F5"/><SolidColorBrush x:Key="FkSidebar" Color="#E6ECEC"/>
    <SolidColorBrush x:Key="FkSurface" Color="#FFFFFF"/><SolidColorBrush x:Key="FkSurface2" Color="#F7FAFA"/>
    <SolidColorBrush x:Key="FkOverlay" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FkBorder" Color="#D4DCDC"/><SolidColorBrush x:Key="FkForeground" Color="#0F1414"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D4DCDC"/>
    <SolidColorBrush x:Key="FkSecondary" Color="#5A6A6A"/><SolidColorBrush x:Key="FkDim" Color="#8A9898"/>
    <SolidColorBrush x:Key="FkAccent" Color="#183739"/>
    <SolidColorBrush x:Key="FkStatusRunning" Color="#0F1414"/>
    <SolidColorBrush x:Key="FkStatusCompleted" Color="#5A6A6A"/>
    <SolidColorBrush x:Key="FkStatusStopped" Color="#AF4B4B"/>
    <SolidColorBrush x:Key="FkStatusInterrupted" Color="#A0732D"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="HighContrast">
    <SolidColorBrush x:Key="FkBackground" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="FkSidebar" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="FkSurface" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="FkSurface2" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="FkOverlay" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="FkBorder" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="FkForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="FkSecondary" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="FkDim" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="FkAccent" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="FkStatusRunning" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="FkStatusCompleted" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="FkStatusStopped" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="FkStatusInterrupted" Color="{ThemeResource SystemColorHighlightColor}"/>
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="FkText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource FkForeground}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FkMutedText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkSecondary}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="FkDimText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkDim}"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="FkSectionText" TargetType="TextBlock" BasedOn="{StaticResource FkMutedText}"><Setter Property="FontSize" Value="11"/><Setter Property="CharacterSpacing" Value="60"/></Style>
  <Style x:Key="FkMetricText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Language" Value="en-US"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextReadingOrder" Value="UseFlowDirection"/></Style>
  <Style x:Key="FkStatusRunningText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkStatusRunning}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="CharacterSpacing" Value="40"/></Style>
  <Style x:Key="FkStatusCompletedText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkStatusCompleted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="CharacterSpacing" Value="40"/></Style>
  <Style x:Key="FkStatusStoppedText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkStatusStopped}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="CharacterSpacing" Value="40"/></Style>
  <Style x:Key="FkStatusInterruptedText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkStatusInterrupted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="CharacterSpacing" Value="40"/></Style>
  <Style x:Key="FkCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource FkSurface}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="FkCardSubtle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource FkSurface2}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="FkNav" TargetType="ToggleButton"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Foreground" Value="{ThemeResource FkForeground}"/></Style>
  <Style x:Key="FkSidebarButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource FkSecondary}"/></Style>
  <Style x:Key="FkBadge" TargetType="Border"><Setter Property="Background" Value="{ThemeResource FkSurface2}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style x:Key="FkBadgeText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkSecondary}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="FkColorButton" TargetType="Button"><Setter Property="Background" Value="{ThemeResource FkSurface2}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="MinWidth" Value="120"/><Setter Property="Padding" Value="10,6,12,6"/></Style>
  <Style x:Key="FkColorHexText" TargetType="TextBlock" BasedOn="{StaticResource FkText}"><Setter Property="Foreground" Value="{ThemeResource FkSecondary}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="FkSwatchBorder" TargetType="Border"><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/></Style>
  <Style x:Key="FkSettingRow" TargetType="Grid"><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/></Style>
  <Style x:Key="FkSegmentContainer" TargetType="Border"><Setter Property="Background" Value="{ThemeResource FkSurface2}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="2"/></Style>
  <Style x:Key="FkSegmentActive" TargetType="Button"><Setter Property="Background" Value="{ThemeResource FkSurface}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Foreground" Value="{ThemeResource FkForeground}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="14,4"/></Style>
  <Style x:Key="FkSegmentInactive" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Foreground" Value="{ThemeResource FkSecondary}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="14,4"/></Style>
  <Style x:Key="FkChartGridLine" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="Opacity" Value="0.5"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  <Style x:Key="FkOverlayCard" TargetType="Button"><Setter Property="Padding" Value="20,18"/><Setter Property="CornerRadius" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="FkOverlayCardSelected" TargetType="Button" BasedOn="{StaticResource FkOverlayCard}"><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="FkOverlayStopButton" TargetType="Button"><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="14,0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{ThemeResource FkSurface2}"/><Setter Property="Foreground" Value="{ThemeResource FkSecondary}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>

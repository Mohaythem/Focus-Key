<Window x:Class="FocusKey.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus Key">
 <Grid x:Name="MainSurface" Background="{ThemeResource FkBackground}" FlowDirection="LeftToRight" Language="en-US">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="NavGrid" Background="{ThemeResource FkSidebar}" Padding="10,20,10,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
   <Grid.Resources>
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource ControlFillColorSecondary}"/>
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ControlFillColorTertiary}"/>
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ControlFillColorSecondary}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorPrimary}"/>
   </Grid.Resources>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="20">
    <StackPanel Padding="12,0" Spacing="6">
     <TextBlock Text="Focus Key" Style="{StaticResource FkText}" FontWeight="SemiBold" FontSize="13" CharacterSpacing="-10"/>
     <StackPanel x:Name="ActiveIndicator" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
      <Ellipse x:Name="ActiveDot" Width="6" Height="6" VerticalAlignment="Center"/>
      <TextBlock x:Name="ActiveHintText" Text="Session active" Style="{StaticResource FkDimText}" FontSize="10"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Spacing="2">
     <ToggleButton x:Name="TodayNav" Style="{StaticResource FkNav}" Click="OnTodayClick" AutomationProperties.Name="Today"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE787;" FontSize="16"/><TextBlock Text="Today" FontSize="13"/></StackPanel></ToggleButton>
     <ToggleButton x:Name="ReportsNav" Style="{StaticResource FkNav}" Click="OnReportsClick" AutomationProperties.Name="Reports"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE9D9;" FontSize="16"/><TextBlock Text="Reports" FontSize="13"/></StackPanel></ToggleButton>
     <ToggleButton x:Name="SettingsNav" Style="{StaticResource FkNav}" Click="OnSettingsClick" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="Settings" FontSize="13"/></StackPanel></ToggleButton>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Row="2" Spacing="8">
    <Button Content="Quick Overlay" Click="OnOverlayClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Background="Transparent" BorderThickness="0" FontSize="12" Foreground="{ThemeResource FkSecondary}"/>
    <Button Content="Exit Focus Key" Click="OnExitClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Background="Transparent" BorderThickness="0" FontSize="12" Foreground="{ThemeResource FkSecondary}"/>
    <Border BorderBrush="{ThemeResource FkBorder}" BorderThickness="0,1,0,0" Padding="12,16,12,0" Margin="0,4,0,0"><StackPanel Spacing="2"><TextBlock x:Name="SidebarOverlayShortcutHint" Text="Shift + F3" Style="{StaticResource FkText}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource FkSecondary}"/><TextBlock Text="One focused session." Style="{StaticResource FkDimText}" FontSize="10"/></StackPanel></Border>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="PageScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="PageContent" Spacing="20" Padding="40,28,40,36" HorizontalAlignment="Stretch">
    <TextBlock x:Name="PageTitle" Text="Today" Style="{StaticResource FkText}" FontSize="16" FontWeight="Medium" AutomationProperties.HeadingLevel="Level1" CharacterSpacing="-10" Visibility="Collapsed"/>
    <ContentControl x:Name="SettingsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch"/>
    <ContentControl x:Name="ReportsHost" Visibility="Collapsed" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" MaxWidth="{StaticResource FkReportsPageMaxWidth}"/>
    <StackPanel x:Name="TodayPanel" Spacing="20" HorizontalAlignment="Center" MaxWidth="{StaticResource FkUtilityPageMaxWidth}">
     <!-- Today Header: Title, Localized Date, and Refresh Action -->
     <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
       <TextBlock Text="Today" Style="{StaticResource FkPageTitleText}" AutomationProperties.HeadingLevel="Level1"/>
       <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock x:Name="DayLabel" Style="{StaticResource FkMutedText}" FontSize="12"/>
        <TextBlock x:Name="LoadStatus" Style="{StaticResource FkDimText}" FontSize="11" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" x:Name="RefreshButton" Click="OnRefreshClick" AutomationProperties.Name="Refresh Today" ToolTipService.ToolTip="Refresh" VerticalAlignment="Top" Padding="8,6" CornerRadius="{StaticResource FkControlRadius}">
       <FontIcon Glyph="&#xE72C;" FontSize="13"/>
      </Button>
     </Grid>
     <TextBlock x:Name="ErrorText" Style="{StaticResource FkText}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
     <Border x:Name="CurrentCard" Style="{StaticResource FkCard}" HorizontalAlignment="Stretch" Padding="28,24,28,24" MinHeight="180">
      <Grid>
       <!-- Active Session View (Hidden when Idle) -->
       <StackPanel x:Name="ActiveContent" Spacing="14" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
         <Ellipse x:Name="ActiveTypeDot" Width="6" Height="6" VerticalAlignment="Center"/>
         <TextBlock x:Name="CurrentHeading" Text="WORK SESSION" Style="{StaticResource FkSectionText}" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid ColumnSpacing="16" Margin="0,2,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock x:Name="RunningText" Style="{StaticResource FkDisplayTimerText}"/>
          <TextBlock x:Name="RunningHint" Text="Remaining" Style="{StaticResource FkMutedText}" FontSize="12"/>
         </StackPanel>
         <Button Grid.Column="1" x:Name="StopButton" Content="Stop" Click="OnStopClick" Visibility="Collapsed" VerticalAlignment="Bottom" Padding="18,7" FontSize="12" CornerRadius="{StaticResource FkControlRadius}" AutomationProperties.Name="Stop Session"/>
        </Grid>
        <ProgressBar x:Name="SessionProgress" Minimum="0" Maximum="100" Visibility="Collapsed" Height="3" CornerRadius="1.5" AutomationProperties.Name="Session progress" Margin="0,4,0,0"/>
       </StackPanel>

       <!-- Idle Hero Launcher View (Visible when Idle) -->
       <StackPanel x:Name="IdleContent" Spacing="14" Visibility="Visible">
        <TextBlock Text="START A SESSION" Style="{StaticResource FkSectionText}" VerticalAlignment="Center"/>
        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>

         <!-- Work Hero Surface -->
         <Border x:Name="WorkChoiceCard" Grid.Column="0" CornerRadius="{StaticResource FkHeroRadius}" BorderThickness="1" Padding="18,14" MinHeight="84"
                 PointerEntered="OnWorkCardPointerEntered" PointerExited="OnWorkCardPointerExited" Tapped="OnStartWorkClick">
          <Grid ColumnSpacing="12">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
           </Grid.ColumnDefinitions>
           <StackPanel Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
             <Ellipse x:Name="WorkChoiceDot" Width="6" Height="6" VerticalAlignment="Center"/>
             <TextBlock x:Name="WorkChoiceMode" Text="WORK" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Style="{StaticResource FkMutedText}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
             <TextBlock x:Name="WorkDurationNumber" Text="30" FontSize="26" FontWeight="SemiBold" Style="{StaticResource FkText}" FontFamily="Segoe UI Variable"/>
             <TextBlock x:Name="WorkDurationUnit" Text="min" FontSize="12" Style="{StaticResource FkMutedText}" FontFamily="Segoe UI Variable" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </StackPanel>
           </StackPanel>
           <Button Grid.Column="1" x:Name="StartWorkButton" Style="{StaticResource FkLauncherStartButton}" Content="Start" Click="OnStartWorkClick" AutomationProperties.Name="Start Work"/>
          </Grid>
         </Border>

         <!-- Break Hero Surface -->
         <Border x:Name="BreakChoiceCard" Grid.Column="1" CornerRadius="{StaticResource FkHeroRadius}" BorderThickness="1" Padding="18,14" MinHeight="84"
                 PointerEntered="OnBreakCardPointerEntered" PointerExited="OnBreakCardPointerExited" Tapped="OnStartBreakClick">
          <Grid ColumnSpacing="12">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
           </Grid.ColumnDefinitions>
           <StackPanel Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
             <Ellipse x:Name="BreakChoiceDot" Width="6" Height="6" VerticalAlignment="Center"/>
             <TextBlock x:Name="BreakChoiceMode" Text="BREAK" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Style="{StaticResource FkMutedText}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
             <TextBlock x:Name="BreakDurationNumber" Text="10" FontSize="26" FontWeight="SemiBold" Style="{StaticResource FkText}" FontFamily="Segoe UI Variable"/>
             <TextBlock x:Name="BreakDurationUnit" Text="min" FontSize="12" Style="{StaticResource FkMutedText}" FontFamily="Segoe UI Variable" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </StackPanel>
           </StackPanel>
           <Button Grid.Column="1" x:Name="StartBreakButton" Style="{StaticResource FkLauncherStartButton}" Content="Start" Click="OnStartBreakClick" AutomationProperties.Name="Start Break"/>
          </Grid>
         </Border>
        </Grid>
       </StackPanel>
      </Grid>
     </Border>
     <Grid x:Name="SummaryGrid" RowSpacing="12" ColumnSpacing="12" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource FkCard}" Padding="20,18">
       <StackPanel Spacing="6">
        <TextBlock x:Name="FocusValue" Text="—" Style="{StaticResource FkMetricValueText}"/>
        <TextBlock Text="Focus Time" Style="{StaticResource FkText}" FontSize="12" FontWeight="Medium"/>
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource FkCard}" Padding="20,18">
       <StackPanel Spacing="6">
        <TextBlock x:Name="WorkValue" Text="—" Style="{StaticResource FkMetricValueText}"/>
        <TextBlock Text="Completed Work" Style="{StaticResource FkText}" FontSize="12" FontWeight="Medium"/>
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource FkCard}" Padding="20,18">
       <StackPanel Spacing="6">
        <TextBlock x:Name="BreakValue" Text="—" Style="{StaticResource FkMetricValueText}"/>
        <TextBlock Text="Break Time" Style="{StaticResource FkText}" FontSize="12" FontWeight="Medium"/>
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FkCard}" Padding="20,18">
       <StackPanel Spacing="6">
        <TextBlock x:Name="CompletionValue" Text="—" Style="{StaticResource FkMetricValueText}"/>
        <TextBlock Text="Completion Rate" Style="{StaticResource FkText}" FontSize="12" FontWeight="Medium"/>
       </StackPanel>
      </Border>
     </Grid>
     <Border Style="{StaticResource FkCard}" Padding="0" HorizontalAlignment="Stretch">
      <StackPanel Spacing="0">
       <Button x:Name="ActivityHeaderButton" Click="OnToggleActivityClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,14" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource FkControlRadius}" AutomationProperties.Name="Activity, toggle collapse">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="ACTIVITY" Style="{StaticResource FkSectionText}" VerticalAlignment="Center"/>
         <FontIcon Grid.Column="1" x:Name="ActivityChevron" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource FkSecondary}" VerticalAlignment="Center"/>
        </Grid>
       </Button>
       <Border x:Name="ActivityContentPanel" BorderBrush="{ThemeResource FkBorder}" BorderThickness="0,1,0,0" Visibility="Collapsed">
        <StackPanel Padding="20,4,20,14">
         <TextBlock x:Name="EmptyActivity" Text="No sessions yet today." Style="{StaticResource FkMutedText}" FontSize="12" Padding="0,14" HorizontalAlignment="Center"/>
         <ItemsControl x:Name="ActivityRows" HorizontalContentAlignment="Stretch"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
